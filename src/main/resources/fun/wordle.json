  "how_to_play": [
    {
      "heading": "WORDLE",
      "paragraphs": [
        "Find today's five-letter answer in {max_guesses} guesses. The answer is the same for every player each day.",
        "Use the pencil on the board to open the guess anvil. Rename the paper to five letters, then click the result to submit."
      ]
    },
    {
      "heading": "YOUR GUESS",
      "paragraphs": [
        "Any five letters from A to Z are accepted, even if they are not a dictionary word. Uppercase and lowercase both work.",
        "A guess that is not exactly five letters, or contains anything other than A-Z, is rejected and does not use a turn."
      ]
    },
    {
      "heading": "READ THE CLUES",
      "paragraphs": [
        "Each letter head is colored:",
        "GREEN: this letter is in the answer and in the right position.",
        "ORANGE: this letter occurs in the answer, but in a different position.",
        "GRAY: no unmatched copy of this letter remains in the answer."
      ]
    },
    {
      "heading": "REPEATED LETTERS",
      "paragraphs": [
        "Repeated letters are counted individually. Correct-position matches are scored first. Other guessed letters are orange only while an unmatched copy remains in the answer."
      ]
    },
    {
      "heading": "REPEATED LETTER EXAMPLE",
      "paragraphs": [
        "If the answer contains one A, guessing A twice does not mean both copies are present. Only one can be green or orange; the extra A is gray."
      ]
    },
    {
      "heading": "KEEP PLAYING",
      "paragraphs": [
        "Use each row's clues to work out which letters are in the word and where they belong. You have {max_guesses} rows; each valid guess fills one row.",
        "Progress is saved after every guess, so you can leave and return to today's puzzle later."
      ]
    },
    {
      "heading": "DAILY RESULTS",
      "paragraphs": [
        "The leaderboard book shows today's completed games, with wins ranked by fewest guesses.",
        "A win pays {base_payout} ECO plus {unused_guess_bonus} ECO for every unused guess. Solving on your first guess earns {first_guess_payout} ECO."
      ]
    }
  ],
  "payouts": {
